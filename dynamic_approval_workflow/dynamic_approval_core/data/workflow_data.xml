<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Default configuration parameters -->
    <record id="config_param_lock_timeout" model="ir.config_parameter">
        <field name="key">dynamic_approval.lock_timeout_ms</field>
        <field name="value">10000</field>
    </record>

    <record id="config_param_lock_retries" model="ir.config_parameter">
        <field name="key">dynamic_approval.lock_retries</field>
        <field name="value">3</field>
    </record>

    <record id="config_param_idempotency_ttl_days" model="ir.config_parameter">
        <field name="key">dynamic_approval.idempotency_ttl_days</field>
        <field name="value">90</field>
    </record>

    <record id="config_param_grant_ttl_hours" model="ir.config_parameter">
        <field name="key">dynamic_approval.grant_default_ttl_hours</field>
        <field name="value">24</field>
    </record>

</odoo>
