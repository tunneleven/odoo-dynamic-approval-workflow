<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== Tree ======== -->
    <record id="workflow_definition_view_list" model="ir.ui.view">
        <field name="name">workflow.definition.list</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="definition_key"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="version_count"/>
            </list>
        </field>
    </record>

    <!-- ======== Form ======== -->
    <record id="workflow_definition_view_form" model="ir.ui.view">
        <field name="name">workflow.definition.form</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Workflow Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="definition_key"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="version_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Versions">
                            <field name="version_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======== Search ======== -->
    <record id="workflow_definition_view_search" model="ir.ui.view">
        <field name="name">workflow.definition.search</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="definition_key"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_company" string="Company"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ======== Action ======== -->
    <record id="workflow_definition_action" model="ir.actions.act_window">
        <field name="name">Workflow Definitions</field>
        <field name="res_model">workflow.definition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="workflow_definition_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first workflow definition
            </p>
        </field>
    </record>

</odoo>
