<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== List ======== -->
    <record id="view_workflow_definition_list" model="ir.ui.view">
        <field name="name">workflow.definition.list</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="definition_key"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="version_count"/>
                <field name="tag_ids" widget="many2many_tags" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ======== Form ======== -->
    <record id="view_workflow_definition_form" model="ir.ui.view">
        <field name="name">workflow.definition.form</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Workflow Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="definition_key"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags"/>
                            <field name="version_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" widget="html"/>
                        </page>
                        <page string="Versions">
                            <field name="version_ids" context="{'default_definition_id': id}">
                                <list editable="bottom">
                                    <field name="version"/>
                                    <field name="state" widget="badge"/>
                                    <field name="effective_from_utc"/>
                                    <field name="effective_to_utc"/>
                                    <field name="published_at_utc"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======== Search ======== -->
    <record id="view_workflow_definition_search" model="ir.ui.view">
        <field name="name">workflow.definition.search</field>
        <field name="model">workflow.definition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="definition_key"/>
                <field name="company_id"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <filter name="my_company" string="My Company"
                        domain="[('company_id', '=', context.get('allowed_company_ids', [False])[0])]"/>
            </search>
        </field>
    </record>

    <!-- ======== Action ======== -->
    <record id="action_workflow_definition" model="ir.actions.act_window">
        <field name="name">Workflow Definitions</field>
        <field name="res_model">workflow.definition</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_workflow_definition_search"/>
        <field name="group_ids" eval="[(6, 0, [ref('dynamic_approval_core.group_workflow_designer')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first workflow definition
            </p>
        </field>
    </record>

</odoo>
