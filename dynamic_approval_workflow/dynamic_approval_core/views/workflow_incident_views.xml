<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== Tree ======== -->
    <record id="view_workflow_incident_list" model="ir.ui.view">
        <field name="name">workflow.incident.list</field>
        <field name="model">workflow.incident</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="severity"
                       widget="badge"
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'high'"/>
                <field name="state" widget="badge"/>
                <field name="instance_id"/>
                <field name="opened_at_utc"/>
            </list>
        </field>
    </record>

    <!-- ======== Form ======== -->
    <record id="view_workflow_incident_form" model="ir.ui.view">
        <field name="name">workflow.incident.form</field>
        <field name="model">workflow.incident</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_triage" type="object"
                            string="Triage"
                            class="btn-primary"
                            invisible="state != 'open'"
                            groups="dynamic_approval_core.group_workflow_admin"/>
                    <button name="action_retry" type="object"
                            string="Retry"
                            class="btn-primary"
                            invisible="state != 'triaged'"
                            groups="dynamic_approval_core.group_workflow_admin"/>
                    <button name="action_resolve" type="object"
                            string="Resolve"
                            class="btn-success"
                            invisible="state not in ('triaged', 'retry_scheduled')"
                            groups="dynamic_approval_core.group_workflow_admin"/>
                    <button name="action_close" type="object"
                            string="Close"
                            class="btn-warning"
                            invisible="state != 'resolved'"
                            groups="dynamic_approval_core.group_workflow_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,triaged,retry_scheduled,resolved,closed_with_exception"/>
                </header>
                <sheet>
                    <group>
                        <group string="Incident">
                            <field name="name"/>
                            <field name="category"/>
                            <field name="severity" widget="badge"/>
                            <field name="instance_id"/>
                            <field name="reason_code"/>
                        </group>
                        <group string="Resolution">
                            <field name="state" readonly="1"/>
                            <field name="resolution_action"/>
                            <field name="opened_at_utc"/>
                            <field name="resolved_at_utc"/>
                            <field name="correlation_id"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="description"/>
                        <field name="resolution_note"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======== Search ======== -->
    <record id="view_workflow_incident_search" model="ir.ui.view">
        <field name="name">workflow.incident.search</field>
        <field name="model">workflow.incident</field>
        <field name="arch" type="xml">
            <search>
                <field name="category"/>
                <field name="severity"/>
                <field name="state"/>
                <field name="instance_id"/>
                <filter name="open_incidents"
                        string="Open"
                        domain="[('state', '=', 'open')]"/>
                <filter name="critical_incidents"
                        string="Critical"
                        domain="[('severity', '=', 'critical')]"/>
                <separator/>
                <filter name="group_by_category"
                        string="By Category"
                        context="{'group_by': 'category'}"/>
                <filter name="group_by_severity"
                        string="By Severity"
                        context="{'group_by': 'severity'}"/>
            </search>
        </field>
    </record>

    <!-- ======== Action ======== -->
    <record id="action_workflow_incident" model="ir.actions.act_window">
        <field name="name">Incidents</field>
        <field name="res_model">workflow.incident</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_workflow_incident_search"/>
        <field name="group_ids" eval="[(6, 0, [ref('dynamic_approval_core.group_workflow_admin')])]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No incidents — everything running smoothly
            </p>
        </field>
    </record>

</odoo>
