<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== Tree ======== -->
    <record id="workflow_incident_view_list" model="ir.ui.view">
        <field name="name">workflow.incident.list</field>
        <field name="model">workflow.incident</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="category"/>
                <field name="severity"
                       decoration-danger="severity == 'critical'"
                       decoration-warning="severity == 'high'"/>
                <field name="state" widget="badge"/>
                <field name="instance_id"/>
                <field name="opened_at_utc"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ======== Form ======== -->
    <record id="workflow_incident_view_form" model="ir.ui.view">
        <field name="name">workflow.incident.form</field>
        <field name="model">workflow.incident</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_triage" type="object"
                            string="Triage"
                            class="btn-primary"
                            invisible="state != 'open'"
                            groups="dynamic_approval_core.group_workflow_admin"/>
                    <button name="action_retry" type="object"
                            string="Retry"
                            class="btn-primary"
                            invisible="state != 'triaged'"
                            groups="dynamic_approval_core.group_workflow_admin"/>
                    <button name="action_resolve" type="object"
                            string="Resolve"
                            class="btn-success"
                            invisible="state not in ('open', 'triaged', 'retry_scheduled')"
                            groups="dynamic_approval_core.group_workflow_admin"/>
                    <button name="action_close_with_exception" type="object"
                            string="Close With Exception"
                            class="btn-warning"
                            invisible="state in ('resolved', 'closed_with_exception')"
                            groups="dynamic_approval_core.group_workflow_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,triaged,retry_scheduled,resolved,closed_with_exception"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="severity"/>
                            <field name="instance_id"/>
                        </group>
                        <group>
                            <field name="reason_code"/>
                            <field name="resolution_action"/>
                            <field name="correlation_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="resolution_note"/>
                    </group>
                    <group>
                        <field name="opened_at_utc"/>
                        <field name="resolved_at_utc"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======== Action ======== -->
    <record id="workflow_incident_action" model="ir.actions.act_window">
        <field name="name">Incidents</field>
        <field name="res_model">workflow.incident</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No incidents — everything running smoothly
            </p>
        </field>
    </record>

</odoo>
