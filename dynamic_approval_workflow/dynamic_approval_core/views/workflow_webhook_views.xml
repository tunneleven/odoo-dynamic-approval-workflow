<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== Tree ======== -->
    <record id="workflow_webhook_endpoint_view_list" model="ir.ui.view">
        <field name="name">workflow.webhook.endpoint.list</field>
        <field name="model">workflow.webhook.endpoint</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="url"/>
                <field name="event_types"/>
                <field name="is_active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ======== Form ======== -->
    <record id="workflow_webhook_endpoint_view_form" model="ir.ui.view">
        <field name="name">workflow.webhook.endpoint.form</field>
        <field name="model">workflow.webhook.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="url"/>
                            <field name="secret" password="True"/>
                        </group>
                        <group>
                            <field name="event_types"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======== Action ======== -->
    <record id="workflow_webhook_endpoint_action" model="ir.actions.act_window">
        <field name="name">Webhook Endpoints</field>
        <field name="res_model">workflow.webhook.endpoint</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
