<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== Tree ======== -->
    <record id="workflow_task_view_list" model="ir.ui.view">
        <field name="name">workflow.task.list</field>
        <field name="model">workflow.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="instance_id"/>
                <field name="assignee_user_id"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-info="status == 'assigned'"
                       decoration-warning="status == 'escalated'"/>
                <field name="decision"/>
                <field name="sla_due_at_utc"/>
                <field name="is_overdue"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ======== Form ======== -->
    <record id="workflow_task_view_form" model="ir.ui.view">
        <field name="name">workflow.task.form</field>
        <field name="model">workflow.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,assigned,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="instance_id"/>
                            <field name="assignee_user_id"/>
                            <field name="assignee_group_id"/>
                            <field name="delegated_from_id"/>
                        </group>
                        <group>
                            <field name="decision"/>
                            <field name="sla_due_at_utc"/>
                            <field name="is_overdue"/>
                            <field name="completed_at_utc"/>
                        </group>
                    </group>
                    <group>
                        <field name="comment"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======== Action ======== -->
    <record id="workflow_task_action" model="ir.actions.act_window">
        <field name="name">Approval Tasks</field>
        <field name="res_model">workflow.task</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No approval tasks yet
            </p>
        </field>
    </record>

    <!-- My Tasks (filtered for current user) -->
    <record id="workflow_task_action_my" model="ir.actions.act_window">
        <field name="name">My Tasks</field>
        <field name="res_model">workflow.task</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('assignee_user_id', '=', uid)]</field>
    </record>

</odoo>
