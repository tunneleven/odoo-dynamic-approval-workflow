<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== Tree ======== -->
    <record id="workflow_binding_view_list" model="ir.ui.view">
        <field name="name">workflow.binding.list</field>
        <field name="model">workflow.binding</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="definition_id"/>
                <field name="target_model"/>
                <field name="target_action_method"/>
                <field name="enforcement_mode"/>
                <field name="is_active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ======== Form ======== -->
    <record id="workflow_binding_view_form" model="ir.ui.view">
        <field name="name">workflow.binding.form</field>
        <field name="model">workflow.binding</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Binding Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="definition_id"/>
                            <field name="target_model"/>
                            <field name="target_action_method"/>
                        </group>
                        <group>
                            <field name="enforcement_mode"/>
                            <field name="compliance_critical"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Post-Approval Callback">
                        <field name="callback_model"/>
                        <field name="callback_method"/>
                    </group>
                    <notebook>
                        <page string="Rollout Scopes">
                            <field name="scope_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ======== Action ======== -->
    <record id="workflow_binding_action" model="ir.actions.act_window">
        <field name="name">Workflow Bindings</field>
        <field name="res_model">workflow.binding</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Bind a workflow to a model action
            </p>
        </field>
    </record>

</odoo>
