<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ======== Retention Policy List ======== -->
    <record id="workflow_retention_policy_view_list" model="ir.ui.view">
        <field name="name">workflow.retention.policy.list</field>
        <field name="model">workflow.retention.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="profile"/>
                <field name="retention_days"/>
                <field name="legal_hold"/>
                <field name="is_active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ======== Retention Policy Form ======== -->
    <record id="workflow_retention_policy_view_form" model="ir.ui.view">
        <field name="name">workflow.retention.policy.form</field>
        <field name="model">workflow.retention.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="profile"/>
                            <field name="retention_days"/>
                        </group>
                        <group>
                            <field name="legal_hold"/>
                            <field name="is_active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Scope">
                        <field name="applies_to_definition_ids"
                               widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ======== Retention Policy Action ======== -->
    <record id="workflow_retention_policy_action" model="ir.actions.act_window">
        <field name="name">Retention Policies</field>
        <field name="res_model">workflow.retention.policy</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ======== Archive Job List ======== -->
    <record id="workflow_archive_job_view_list" model="ir.ui.view">
        <field name="name">workflow.archive.job.list</field>
        <field name="model">workflow.archive.job</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="job_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-danger="state == 'failed'"/>
                <field name="instances_processed"/>
                <field name="instances_skipped"/>
                <field name="executed_at_utc"/>
                <field name="executed_by_id"/>
            </list>
        </field>
    </record>

    <!-- ======== Archive Job Action ======== -->
    <record id="workflow_archive_job_action" model="ir.actions.act_window">
        <field name="name">Archive Jobs</field>
        <field name="res_model">workflow.archive.job</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
