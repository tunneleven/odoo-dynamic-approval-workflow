<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Archival cron — marks eligible completed instances active=False -->
    <record id="ir_cron_workflow_archival" model="ir.cron">
        <field name="name">Workflow: Archival Job</field>
        <field name="model_id" ref="model_workflow_archive_job"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
        <field name="code">model._cron_run_archival()</field>
    </record>

</odoo>
