<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="dynamic_approval_bpmn.BpmnModeler">
        <div class="o_daw_bpmn_modeler_wrapper">
            <!-- Toolbar -->
            <div class="o_daw_bpmn_toolbar d-flex align-items-center gap-2 mb-2"
                 t-if="!props.readonly">
                <button class="btn btn-sm btn-primary"
                        t-on-click="onSaveClick"
                        title="Save diagram">
                    <i class="fa fa-save"/> Save
                </button>
                <button class="btn btn-sm btn-outline-secondary"
                        t-on-click="onValidateClick"
                        title="Validate BPMN">
                    <i class="fa fa-check-circle"/> Validate
                </button>
                <button class="btn btn-sm btn-outline-secondary"
                        t-on-click="onFitClick"
                        title="Fit to viewport">
                    <i class="fa fa-arrows-alt"/> Fit
                </button>
                <span class="badge text-bg-warning ms-2"
                      t-if="state.isDirty">
                    Unsaved changes
                </span>
            </div>

            <!-- Loading indicator -->
            <div class="o_daw_bpmn_loading text-center p-5"
                 t-if="state.loading">
                <i class="fa fa-spinner fa-spin fa-2x"/>
                <p class="mt-2 text-muted">Loading BPMN modeler...</p>
            </div>

            <!-- BPMN canvas container -->
            <div t-ref="bpmnContainer"
                 class="o_daw_bpmn_modeler"
                 t-att-class="{'d-none': state.loading}"/>

            <!-- Validation results -->
            <div class="o_daw_bpmn_validation mt-2"
                 t-if="state.validationErrors.length > 0 or state.validationWarnings.length > 0">
                <div class="alert alert-danger mb-1"
                     t-foreach="state.validationErrors"
                     t-as="error"
                     t-key="error_index">
                    <i class="fa fa-exclamation-triangle"/>
                    <strong t-esc="error.error_code"/>:
                    <span t-esc="error.remediation_hint or error.message"/>
                </div>
                <div class="alert alert-warning mb-1"
                     t-foreach="state.validationWarnings"
                     t-as="warning"
                     t-key="warning_index">
                    <i class="fa fa-info-circle"/>
                    <strong t-esc="warning.error_code"/>:
                    <span t-esc="warning.remediation_hint or warning.message"/>
                </div>
            </div>
        </div>
    </t>

</templates>
