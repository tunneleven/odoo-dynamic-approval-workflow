# Worker configuration
REPO=tunneleven/odoo-dynamic-approval-workflow
AGENT=codex
ASSIGNEE=tunneleven
POLL_SECONDS=90
MAX_TASKS_PER_CYCLE=1
INCLUDE_EITHER=1
DRY_RUN=0

# Command used to start task execution.
# Placeholders supported by agent_queue_worker.py:
# {repo} {agent_mode} {issue_number} {issue_title} {issue_url} {task_id}
START_COMMAND=codex run "Before doing anything else, read docs/plans/2026-03-02-agent-task-execution-workflow.md and follow it as the default task checklist. Then resolve {task_id} from issue #{issue_number}: {issue_title}. Issue URL: {issue_url}"
